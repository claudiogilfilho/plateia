# O MVP abre como visitante quando o OAuth não está configurado.
PLATEIA_AUTH_MODE=guest
PLATEIA_GUEST_NAME=Visitante do Platéia
# PLATEIA_GUEST_ADMIN=false

# Escolha um motor: builtin, openai-compatible ou bridge.
PLATEIA_AI_PROVIDER=openai-compatible
PLATEIA_AI_BASE_URL=https://seu-provedor.example/v1
PLATEIA_AI_API_KEY=
PLATEIA_AI_MODEL=
PLATEIA_AI_STRUCTURED_OUTPUT=json_schema
PLATEIA_AI_VIDEO_PART=unsupported

# Ponte neutra alternativa:
# PLATEIA_AI_PROVIDER=bridge
# PLATEIA_AI_BRIDGE_URL=https://sua-ponte.example/plateia/evaluate

# O MVP usa memória e upload inline quando estes serviços não existem.
# Para persistência de produção, configure:
# DATABASE_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
